{
	"name": "resq-systems-workspace",
	"private": true,
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"scripts": {
		"prepare": "git config core.hooksPath .git-hooks",
		"ws": "bun scripts/ws.ts",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"changeset:status": "changeset status",
		"release": "bun run build && changeset publish",
		"build": "bun --filter '*' build",
		"test": "bun --filter '*' test",
		"lint": "bun --filter @resq-systems/ui lint && node scripts/check-no-workspace-protocol.mjs && node scripts/check-changelog-comments.mjs"
	},
	"packageManager": "bun@1.3.10",
	"dependencies": {
		"@types/bun": "^1.3.14",
		"js-yaml": "^5.2.3",
		"sharp": "^0.35.3"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.1",
		"puppeteer-core": "^25.5.0"
	},
	"overrides": {
		"effect": "4.0.0-beta.93",
		"typescript": "6.0.3",
		"vite": "^8.1.4",
		"defu": ">=6.1.5",
		"next": "^16.2.11",
		"postcss": ">=8.5.18",
		"uuid": ">=14.0.0",
		"dompurify": ">=3.4.13",
		"undici": "^7.29.0",
		"ws": "^8.21.0",
		"brace-expansion": "^5.0.9",
		"@babel/core": "^7.29.7",
		"esbuild": "0.28.1",
		"sharp": "^0.35.3",
		"fast-uri": "^3.1.5",
		"socket.io-parser": "^4.2.7",
		"nanoid": "^3.3.18"
	}
}
