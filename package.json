{
	"name": "resq-systems-workspace",
	"private": true,
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"scripts": {
		"prepare": "git config core.hooksPath .git-hooks",
		"ws": "bun scripts/ws.ts",
		"deps": "bun scripts/dependencies.ts",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"changeset:status": "changeset status",
		"release": "bun run build && changeset publish",
		"build": "bun --filter '*' build",
		"test": "bun --filter '*' test",
		"lint": "bun --filter @resq-systems/ui lint && node scripts/check-no-workspace-protocol.mjs && node scripts/check-changelog-comments.mjs"
	},
	"packageManager": "bun@1.3.10",
	"dependencies": {
		"@types/bun": "^1.4.2",
		"js-yaml": "^5.4.3",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@npmcli/arborist": "^10.0.3",
		"@types/npmcli__arborist": "^6.3.3",
		"puppeteer-core": "^25.12.0"
	},
	"overrides": {
		"@babel/core": "^7.29.7",
		"baseline-browser-mapping": "^2.11.0",
		"brace-expansion": "^5.0.12",
		"browserslist": "^4.28.7",
		"defu": ">=6.1.5",
		"dompurify": ">=3.4.16",
		"effect": "^4.0.0",
		"engine.io": "^6.6.10",
		"esbuild": "0.28.1",
		"fast-uri": "^3.1.8",
		"fflate": "^0.4.9",
		"ip-address": "^10.7.1",
		"js-yaml": "^5.4.1",
		"markdown-it": "^14.3.1",
		"nanoid": "^3.3.18",
		"next": "^16.3.8",
		"postcss": ">=8.5.18",
		"sharp": "^0.35.4",
		"smol-toml": "^1.7.1",
		"socket.io-parser": "^4.2.7",
		"toml": "^4.2.0",
		"typescript": "7.0.2",
		"undici": "^7.29.1",
		"uuid": ">=14.0.0",
		"vite": "^8.1.4",
		"ws": "^8.21.0"
	}
}
