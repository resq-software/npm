{
	"name": "@resq-sw/analytics",
	"version": "0.4.0",
	"description": "Unified PostHog + GA4 analytics client for the ResQ platform — cross-subdomain, lazy-loaded, with typed events",
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.js",
			"default": "./lib/index.js"
		},
		"./react": {
			"types": "./lib/react/index.d.ts",
			"import": "./lib/react/index.js",
			"default": "./lib/react/index.js"
		},
		"./next": {
			"types": "./lib/next/index.d.ts",
			"import": "./lib/next/index.js",
			"default": "./lib/next/index.js"
		}
	},
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"files": [
		"lib",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"posthog-js": ">=1.180.0",
		"react": ">=19",
		"react-dom": ">=19"
	},
	"peerDependenciesMeta": {
		"posthog-js": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.16",
		"posthog-js": "^1.380.1",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tsdown": "^0.22.2",
		"typescript": "6.0.3",
		"vitest": "4.1.8"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/resq-software/npm.git",
		"directory": "packages/analytics"
	},
	"keywords": [
		"analytics",
		"posthog",
		"ga4",
		"google-analytics",
		"product-analytics",
		"resq"
	],
	"engines": {
		"node": ">=20.19.0"
	}
}
