{
	"name": "@resq-systems/analytics",
	"version": "0.4.1",
	"description": "Unified PostHog + GA4 analytics client for the ResQ Systems platform — cross-subdomain, lazy-loaded, with typed events",
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.js",
			"default": "./lib/index.js"
		},
		"./react": {
			"types": "./lib/react/index.d.ts",
			"import": "./lib/react/index.js",
			"default": "./lib/react/index.js"
		},
		"./next": {
			"types": "./lib/next/index.d.ts",
			"import": "./lib/next/index.js",
			"default": "./lib/next/index.js"
		}
	},
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"files": [
		"lib",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"test": "vitest run"
	},
	"dependencies": {
		"@resq-systems/types": "workspace:*"
	},
	"peerDependencies": {
		"posthog-js": ">=1.180.0",
		"react": ">=19",
		"react-dom": ">=19"
	},
	"peerDependenciesMeta": {
		"posthog-js": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"devDependencies": {
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"posthog-js": "^1.399.1",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tsdown": "^0.22.4",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/resq-software/npm.git",
		"directory": "packages/analytics"
	},
	"keywords": [
		"analytics",
		"posthog",
		"ga4",
		"google-analytics",
		"product-analytics",
		"resq"
	],
	"engines": {
		"node": ">=20.19.0"
	}
}
