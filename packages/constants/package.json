{
	"name": "@resq-systems/constants",
	"version": "0.4.0",
	"description": "Shared, zero-dependency constants for ResQ Systems apps: design tokens (oklch + email-safe hex), brand identity, and cross-app values",
	"license": "Apache-2.0",
	"author": {
		"name": "ResQ Systems, Inc."
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.js",
			"default": "./lib/index.js"
		},
		"./tokens": {
			"types": "./lib/tokens.d.ts",
			"import": "./lib/tokens.js",
			"default": "./lib/tokens.js"
		},
		"./brand": {
			"types": "./lib/brand.d.ts",
			"import": "./lib/brand.js",
			"default": "./lib/brand.js"
		},
		"./tokens.css": "./src/tokens.css"
	},
	"main": "lib/index.js",
	"module": "lib/index.js",
	"types": "lib/index.d.ts",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"lib",
		"src/tokens.css",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"tsc": "tsc --noEmit"
	},
	"devDependencies": {
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^26.1.1",
		"@vitest/coverage-v8": "4.1.10",
		"tsdown": "^0.22.4",
		"typescript": "7.0.2",
		"vitest": "4.1.8"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/resq-software/npm.git",
		"directory": "packages/constants"
	},
	"keywords": [
		"constants",
		"design-tokens",
		"brand",
		"oklch",
		"theme"
	],
	"engines": {
		"node": ">=20.19.0"
	}
}
