# Security headers for the hosted Storybook (design.resq.software).
#
# Cloudflare Workers static assets read this file from the root of the
# assets directory. Storybook copies it there via `staticDirs` in
# .storybook/main.ts — it is not applied by `storybook dev` locally.
#
# Two deliberate concessions, both forced by Storybook's architecture:
#
#   1. frame-ancestors 'self' (not 'none') and X-Frame-Options SAMEORIGIN
#      (not DENY). Storybook renders every story inside iframe.html; DENY
#      breaks the preview canvas entirely.
#
#   2. 'unsafe-inline' in script-src. A nonce-based CSP needs per-request
#      server rendering; this is a fully static export, so Storybook's
#      inline bootstrap cannot carry a nonce. This is a real weakening — treat
#      access control (Cloudflare Access) as the primary control, not CSP.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'
