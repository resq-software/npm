{
	"name": "@resq-systems/map",
	"version": "4.0.0",
	"description": "MapLibre + react-map-gl telemetry map primitives \u2014 a themeable map shell, asset markers, and track layers that bind to @resq-systems/telemetry",
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.js",
			"default": "./lib/index.js"
		}
	},
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"files": [
		"lib",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@resq-systems/telemetry": ">=0.4.0",
		"maplibre-gl": ">=5",
		"react": ">=19",
		"react-dom": ">=19",
		"react-map-gl": ">=8"
	},
	"peerDependenciesMeta": {
		"@resq-systems/telemetry": {
			"optional": true
		}
	},
	"devDependencies": {
		"@resq-systems/telemetry": "^0.4.0",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/geojson": "^7946.0.14",
		"@types/node": "^26.6.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"maplibre-gl": "6.10.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-map-gl": "^8.1.3",
		"tsdown": "^0.23.0",
		"typescript": "7.0.2",
		"vitest": "5.0.1"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
