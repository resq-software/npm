{
	"name": "@resq-systems/map",
	"version": "0.1.0",
	"description": "MapLibre + react-map-gl telemetry map primitives — a themeable map shell, asset markers, and track layers that bind to @resq-systems/telemetry",
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.js",
			"default": "./lib/index.js"
		}
	},
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"files": [
		"lib",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@resq-systems/telemetry": ">=0.1.0",
		"maplibre-gl": ">=5",
		"react": ">=19",
		"react-dom": ">=19",
		"react-map-gl": ">=8"
	},
	"peerDependenciesMeta": {
		"@resq-systems/telemetry": {
			"optional": true
		}
	},
	"devDependencies": {
		"@resq-systems/telemetry": "^0.1.0",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/geojson": "^7946.0.14",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"maplibre-gl": "5.24.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-map-gl": "^8.1.0",
		"tsdown": "^0.22.9",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/resq-software/npm.git",
		"directory": "packages/map"
	},
	"keywords": [
		"map",
		"maplibre",
		"react-map-gl",
		"telemetry",
		"fleet",
		"gis",
		"resq"
	],
	"engines": {
		"node": ">=20.19.0"
	}
}
