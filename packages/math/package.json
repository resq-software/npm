{
	"name": "@resq-systems/math",
	"version": "0.2.1",
	"description": "Type-safe mathematical expression engine with sort-based dispatch, Pratt parser, and static validation",
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		".": {
