{
	"name": "@resq-systems/telemetry",
	"version": "0.3.0",
	"description": "Framework-agnostic real-time telemetry client — single-owner WebSocket with exponential backoff, channel multiplexing, and open-replay, plus React bindings",
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.js",
			"default": "./lib/index.js"
		},
		"./react": {
			"types": "./lib/react/index.d.ts",
			"import": "./lib/react/index.js",
			"default": "./lib/react/index.js"
		}
	},
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"files": [
		"lib",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"react": ">=19"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.17",
		"react": "^19.2.8",
		"tsdown": "^0.22.14",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/resq-software/npm.git",
		"directory": "packages/telemetry"
	},
	"keywords": [
		"telemetry",
		"websocket",
		"realtime",
		"reconnect",
		"backoff",
		"react",
		"resq"
	],
	"engines": {
		"node": ">=20.19.0"
	}
}
